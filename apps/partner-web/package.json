{
  "name": "partner-web",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "next build --webpack && node scripts/check-static-export.mjs",
    "build:e2e": "PARTNER_EVIDENCE_ORIGIN=http://localhost:4321 next build --webpack && node scripts/check-static-export.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "mock": "node mock/server.mjs",
    "e2e": "playwright test",
    "test": "npm run test:unit && npm run e2e"
  },
  "dependencies": {
    "next": "16.4.2",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.5"
    },
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.41",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
