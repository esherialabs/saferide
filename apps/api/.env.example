NODE_ENV=development
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=3333
API_PUBLIC_BASE_URL=http://localhost:3333/api
WS_PUBLIC_BASE_URL=ws://localhost:3334
AUTH_PUBLIC_BASE_URL=http://localhost:3333/auth
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/evidence

# Use DATABASE_URL locally. In AWS/ECS, omit DATABASE_URL and inject the
# DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER, DATABASE_PASSWORD,
# and optional DATABASE_SSLMODE parts from SSM/Secrets Manager.
DATABASE_URL=postgres://saferide:local-example-postgres-password@localhost:55432/saferide
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=saferide
# DATABASE_USER=saferide
# DATABASE_PASSWORD=local-example-postgres-password
# DATABASE_SSLMODE=require
REDIS_URL=redis://localhost:6379
AUTH_JWT_SECRET=local-example-auth-jwt-secret-32-byte-value

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=local
S3_BUCKET=evidence
S3_CREDENTIAL_MODE=static
S3_ACCESS_KEY_ID=saferide-minio
S3_SECRET_ACCESS_KEY=local-example-minio-root-password

CORS_ORIGINS=*
# Partner dashboard host (bare https origin).
# PARTNER_PUBLIC_ORIGIN=https://partners.example.invalid
# 32-byte key (64 hex chars or base64) sealing partner TOTP secrets, e.g. from
# `openssl rand -base64 32`. The partner realm stays off unless the origin,
# this key and PARTNER_TRUSTED_PROXY_CIDRS are all set.
# PARTNER_TOTP_KEY=
# Optional browser push: API gets the public key and internal relay credential;
# the VAPID private key belongs only to the isolated relay (selfhost push.env).
# PARTNER_PUSH_PUBLIC_KEY=
# PARTNER_PUSH_RELAY_SECRET=
# Dedicated 32-byte key (64 hex chars or base64) sealing survivor callback
# numbers, e.g. from `openssl rand -base64 32`. Unset: callbacks are refused.
# PARTNER_CALLBACK_KEY=
# Gateway address range whose X-Real-IP header is trusted for partner rate
# limits (the gateway overwrites it); only the gateway's own address. Without
# it the partner realm is refused and stays off.
# PARTNER_TRUSTED_PROXY_CIDRS=192.0.2.10/32
# Partner evidence downloads. `disabled` (the default) until server-side
# derivatives strip EXIF/XMP/IPTC, MP4/MOV location atoms and PDF metadata;
# `originals` serves raw files and is refused unless APP_ENV is development or test.
# PARTNER_EVIDENCE_DOWNLOAD=disabled
# clamd (ClamAV) for evidence malware scanning, e.g. the selfhost `clamav`
# service (clamd-scan:3310). Unset: no scanner, so evidence ingestion is
# refused and nothing is released.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
# Scans the API runs at once (1 or 2).
# EVIDENCE_SCAN_CONCURRENCY=1
LOG_LEVEL=info
