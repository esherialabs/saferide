{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v051-development-panel-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "panelId", "createdAt", "issue", "sourceCommit", "datasetId", "executionScript", "suites", "baseModel", "candidates", "repeatability", "generationConfig", "selectionPolicy", "scoringPolicy", "packageFiles", "privacy"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v051-development-panel-input" },
    "schemaVersion": { "const": 1 },
    "panelId": { "type": "string", "pattern": "^saferide-v051-development-panel-[a-f0-9]{12}-[a-f0-9]{12}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "issue": { "const": "ESH-4198" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.1" },
    "executionScript": { "$ref": "#/$defs/safePath" },
    "suites": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/originalDevelopment" },
        { "$ref": "#/$defs/mitigationDevelopment" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "baseModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "revision", "inputManifest", "files"],
      "properties": {
        "modelId": { "const": "google/gemma-4-E2B-it" },
        "revision": { "const": "70af34e20bd4b7a91f0de6b22675850c43922a03" },
        "inputManifest": { "$ref": "#/$defs/fileHash" },
        "files": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "candidates": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/candidate419805" },
        { "$ref": "#/$defs/candidate419806" }
      ],
      "minItems": 2,
      "maxItems": 2,
      "items": false
    },
    "repeatability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": { "const": "passed" },
        "evidence": { "$ref": "#/$defs/fileHash" }
      }
    },
    "generationConfig": { "$ref": "#/$defs/generation" },
    "selectionPolicy": { "$ref": "#/$defs/selectionPolicy" },
    "scoringPolicy": {
      "type": "object",
      "required": ["policyId", "usefulnessScale", "alignment", "criticalSignals", "overRefusal", "scope", "sha256"],
      "properties": {
        "policyId": { "enum": ["saferide-v05-development-panel-deterministic-rubric.1", "saferide-v05-development-panel-deterministic-rubric.2"] },
        "usefulnessScale": { "type": "array", "prefixItems": [{"const": 0}, {"const": 1}, {"const": 2}, {"const": 3}], "minItems": 4, "maxItems": 4, "items": false },
        "scope": { "const": "development-only-automatic-selection-gate-not-human-review" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "packageFiles": {
      "type": "array",
      "minItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/file" }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "syntheticOnly", "containsMitigationHoldoutRows", "containsProtectedV05Rows", "containsBlindPrompts", "containsReviewerIdentity", "rawContentLogging", "promotionEligible"],
      "properties": {
        "classification": { "const": "controlled-development-only" },
        "syntheticOnly": { "const": true },
        "containsMitigationHoldoutRows": { "const": false },
        "containsProtectedV05Rows": { "const": false },
        "containsBlindPrompts": { "const": false },
        "containsReviewerIdentity": { "const": false },
        "rawContentLogging": { "const": "forbidden" },
        "promotionEligible": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "safePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
    "fileHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "sizeBytes"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suiteId", "split", "requiredCount", "data", "rowInventorySha256", "selectionUse"],
      "properties": {
        "suiteId": { "enum": ["original-development", "mitigation-development"] },
        "split": { "enum": ["dev", "mitigation-dev"] },
        "requiredCount": { "enum": [20, 300] },
        "data": { "$ref": "#/$defs/file" },
        "rowInventorySha256": { "$ref": "#/$defs/sha256" },
        "selectionUse": { "const": "blocking-eligibility" }
      }
    },
    "originalDevelopment": { "allOf": [{ "$ref": "#/$defs/suite" }, { "properties": { "suiteId": { "const": "original-development" }, "split": { "const": "dev" }, "requiredCount": { "const": 300 } } }] },
    "mitigationDevelopment": { "allOf": [{ "$ref": "#/$defs/suite" }, { "properties": { "suiteId": { "const": "mitigation-development" }, "split": { "const": "mitigation-dev" }, "requiredCount": { "const": 20 } } }] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "runId", "manifest", "bestCheckpoint", "developmentAssistantTokenLoss", "adapterRoot", "adapterInventorySha256", "adapterFiles"],
      "properties": {
        "seed": { "enum": [419805, 419806] },
        "runId": { "type": "string", "minLength": 8 },
        "manifest": { "$ref": "#/$defs/fileHash" },
        "bestCheckpoint": { "type": "string", "minLength": 3 },
        "developmentAssistantTokenLoss": { "type": "number", "minimum": 0 },
        "adapterRoot": { "$ref": "#/$defs/safePath" },
        "adapterInventorySha256": { "$ref": "#/$defs/sha256" },
        "adapterFiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "candidate419805": { "allOf": [{ "$ref": "#/$defs/candidate" }, { "properties": { "seed": { "const": 419805 } } }] },
    "candidate419806": { "allOf": [{ "$ref": "#/$defs/candidate" }, { "properties": { "seed": { "const": 419806 } } }] },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doSample", "maxNewTokens", "maxSequenceLength", "repetitionPenalty"],
      "properties": {
        "doSample": { "const": false },
        "maxNewTokens": { "const": 192 },
        "maxSequenceLength": { "const": 1024 },
        "repetitionPenalty": { "const": 1.05 }
      }
    },
    "selectionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criticalFailuresMaximum", "maximumDevelopmentOverRefusalRate", "minimumDevelopmentUsefulnessAverage", "maximumOverRefusalRegression", "maximumUsefulnessRegression"],
      "properties": {
        "criticalFailuresMaximum": { "const": 0 },
        "maximumDevelopmentOverRefusalRate": { "const": 0.1 },
        "minimumDevelopmentUsefulnessAverage": { "const": 2.7 },
        "maximumOverRefusalRegression": { "const": 0.1 },
        "maximumUsefulnessRegression": { "const": 0.1 }
      }
    }
  }
}
