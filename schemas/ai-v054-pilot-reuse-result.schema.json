{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v054-pilot-reuse-result.schema.json",
  "title": "SafeRide v0.5.4 governed pilot reuse and panel result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "issue",
    "branch",
    "pullRequest",
    "status",
    "createdAt",
    "bindings",
    "preservedNoGoEvidence",
    "screens",
    "preflight",
    "pilot",
    "panel",
    "gpu",
    "validation",
    "decision",
    "privacy",
    "untouched"
  ],
  "properties": {
    "schema": { "const": "com.saferide.ai.v054-pilot-reuse-result" },
    "schemaVersion": { "const": 1 },
    "issue": { "const": "ESH-4198" },
    "branch": { "const": "codex/esh-4198-v051-mitigation" },
    "pullRequest": { "const": 205 },
    "status": { "const": "no-go-panel-gates-failed" },
    "createdAt": { "type": "string", "format": "date-time" },
    "bindings": { "type": "object" },
    "preservedNoGoEvidence": { "type": "object" },
    "screens": { "type": "object" },
    "preflight": { "type": "object" },
    "pilot": { "type": "object" },
    "panel": { "type": "object" },
    "gpu": { "type": "object" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "v054PythonTests",
        "v054NodeTests",
        "v053PythonTests",
        "v053NodeTests",
        "secretScanFiles",
        "historicalValidatorsPassed",
        "evidenceSchemasPassed",
        "secretScanPassed",
        "diffCheckPassed",
        "equivalentDuplicateRegressionPassed",
        "conflictingDuplicateRegressionPassed",
        "genuineDisclosureRegressionPassed"
      ],
      "properties": {
        "status": { "enum": ["pending-final-local-validation", "passed"] },
        "v054PythonTests": { "type": ["integer", "null"], "minimum": 1 },
        "v054NodeTests": { "type": ["integer", "null"], "minimum": 1 },
        "v053PythonTests": { "type": ["integer", "null"], "minimum": 1 },
        "v053NodeTests": { "type": ["integer", "null"], "minimum": 1 },
        "secretScanFiles": { "type": ["integer", "null"], "minimum": 1 },
        "historicalValidatorsPassed": { "type": ["boolean", "null"] },
        "evidenceSchemasPassed": { "type": ["boolean", "null"] },
        "secretScanPassed": { "type": ["boolean", "null"] },
        "diffCheckPassed": { "type": ["boolean", "null"] },
        "equivalentDuplicateRegressionPassed": { "type": ["boolean", "null"] },
        "conflictingDuplicateRegressionPassed": { "type": ["boolean", "null"] },
        "genuineDisclosureRegressionPassed": { "type": ["boolean", "null"] }
      }
    },
    "decision": {
      "type": "object",
      "required": ["strictDecision", "readyForTwoFullCandidateTraining", "failedGates", "passedGates", "nextTechnicalCorrection", "reauthorizationRequired"],
      "properties": {
        "strictDecision": { "const": "NO-GO" },
        "readyForTwoFullCandidateTraining": { "const": false },
        "failedGates": { "type": "array", "minItems": 1 },
        "passedGates": { "type": "array", "minItems": 1 },
        "nextTechnicalCorrection": { "type": "string", "minLength": 1 },
        "reauthorizationRequired": { "const": true }
      }
    },
    "privacy": { "type": "object" },
    "untouched": { "type": "object" }
  }
}
