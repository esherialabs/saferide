{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v051-mitigation-holdout-summary.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "summaryId", "createdAt", "issue", "status", "datasetId", "selection", "suite", "baseModel", "candidate", "provenance", "generation", "coverage", "metrics", "rawArtifacts", "eligibility", "evaluationPolicy", "privacy", "promotionEligible", "remainingPromotionGates"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v051-mitigation-holdout-summary" },
    "schemaVersion": { "const": 1 },
    "summaryId": { "type": "string", "pattern": "^saferide-v051-mitigation-holdout-[a-f0-9]{12}-[a-f0-9]{12}-summary$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "issue": { "const": "ESH-4198" },
    "status": { "enum": ["passed", "blocked"] },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.1" },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "selectedRunId", "selectedSeed", "panelSummarySha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "selectedRunId": { "type": "string", "minLength": 8 },
        "selectedSeed": { "enum": [419805, 419806] },
        "panelSummarySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "suite": {
      "type": "object", "additionalProperties": false,
      "required": ["suiteId", "requiredCount", "dataSha256", "rowInventorySha256"],
      "properties": {
        "suiteId": { "const": "mitigation-holdout" },
        "requiredCount": { "const": 20 },
        "dataSha256": { "$ref": "#/$defs/sha256" },
        "rowInventorySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseModel": {
      "type": "object", "additionalProperties": false,
      "required": ["modelId", "revision"],
      "properties": {
        "modelId": { "const": "google/gemma-4-E2B-it" },
        "revision": { "const": "70af34e20bd4b7a91f0de6b22675850c43922a03" }
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "runId", "manifestSha256", "bestCheckpoint", "adapterInventorySha256"],
      "properties": {
        "seed": { "enum": [419805, 419806] },
        "runId": { "type": "string", "minLength": 8 },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "bestCheckpoint": { "type": "string", "minLength": 3 },
        "adapterInventorySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluationInputSha256", "sourceCommit", "imageDigest", "jobNameSha256", "scoringPolicySha256", "oneTimeAccessReceiptSha256"],
      "properties": {
        "evaluationInputSha256": { "$ref": "#/$defs/sha256" },
        "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "imageDigest": { "$ref": "#/$defs/sha256" },
        "jobNameSha256": { "$ref": "#/$defs/sha256" },
        "scoringPolicySha256": { "$ref": "#/$defs/sha256" },
        "oneTimeAccessReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generation": { "$ref": "ai-v051-development-panel-input.schema.json#/$defs/generation" },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate", "base"],
      "properties": { "candidate": { "$ref": "#/$defs/coverage" }, "base": { "$ref": "#/$defs/coverage" } }
    },
    "metrics": { "$ref": "#/$defs/metrics" },
    "rawArtifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "candidateBundleSha256", "baseBundleSha256"],
      "properties": {
        "classification": { "const": "restricted-synthetic-raw" },
        "candidateBundleSha256": { "$ref": "#/$defs/sha256" },
        "baseBundleSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "eligibility": {
      "type": "object", "additionalProperties": false,
      "required": ["passed", "reasons"],
      "properties": {
        "passed": { "type": "boolean" },
        "reasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } }
      }
    },
    "evaluationPolicy": { "$ref": "ai-v051-mitigation-holdout-input.schema.json#/properties/evaluationPolicy" },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["summaryContainsRawPrompts", "summaryContainsRawCompletions", "mitigationHoldoutRead", "protectedV05RowsRead", "blindPromptsRead", "humanReviewClaimed", "classification"],
      "properties": {
        "summaryContainsRawPrompts": { "const": false },
        "summaryContainsRawCompletions": { "const": false },
        "mitigationHoldoutRead": { "const": true },
        "protectedV05RowsRead": { "const": false },
        "blindPromptsRead": { "const": false },
        "humanReviewClaimed": { "const": false },
        "classification": { "const": "controlled-content-free" }
      }
    },
    "promotionEligible": { "const": false },
    "remainingPromotionGates": {
      "type": "array",
      "prefixItems": [
        { "const": "protected-v05-evaluation" },
        { "const": "consolidated-human-review" },
        { "const": "export" },
        { "const": "physical-device-proof" }
      ],
      "minItems": 4, "maxItems": 4, "items": false
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["rowCount", "completed", "truncated", "errors"],
      "properties": {
        "rowCount": { "const": 20 },
        "completed": { "type": "integer", "minimum": 0, "maximum": 20 },
        "truncated": { "type": "integer", "minimum": 0, "maximum": 20 },
        "errors": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["criticalFailures", "overRefusalRate", "usefulnessAverage", "baseCriticalFailures", "baseOverRefusalRate", "baseUsefulnessAverage"],
      "properties": {
        "criticalFailures": { "type": "integer", "minimum": 0 },
        "overRefusalRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "usefulnessAverage": { "type": "number", "minimum": 0, "maximum": 3 },
        "baseCriticalFailures": { "type": "integer", "minimum": 0 },
        "baseOverRefusalRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "baseUsefulnessAverage": { "type": "number", "minimum": 0, "maximum": 3 }
      }
    }
  }
}
