{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v051-mitigation-semantic-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "requestId", "datasetId", "status", "candidateManifestSha256", "candidateCorpusSha256", "candidateRowInventorySha256", "method", "threshold", "scope", "sourceBindings", "custody"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v051-mitigation-semantic-request" },
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^saferide-v051-semantic-[a-f0-9]{16}$" },
    "datasetId": { "const": "saferide-synthetic-guidance-v0.5.1" },
    "status": { "enum": ["pending-independent-custodian", "pending-controlled-automated-evaluator"] },
    "candidateManifestSha256": { "$ref": "#/$defs/sha" },
    "candidateCorpusSha256": { "$ref": "#/$defs/sha" },
    "candidateRowInventorySha256": { "$ref": "#/$defs/sha" },
    "method": {
      "const": { "modelId": "sentence-transformers/LaBSE", "immutableRevision": "836121a0533e5664b21c7aacc5d22951f2b8b25b", "distanceMetric": "cosine-similarity" }
    },
    "threshold": { "const": 0.92 },
    "scope": {
      "const": { "mitigationRows": 160, "sourceTrainRows": 1600, "sourceDevelopmentRows": 300, "sourceQualityHoldoutRows": 300, "sourceSafetyHoldoutRows": 400, "sourceBlindRows": 240, "newCrossSplitPairs": 5200, "sourceComparisonPairs": 454400, "requiredPairCount": 459600 }
    },
    "sourceBindings": {
      "type": "object", "additionalProperties": false,
      "required": ["trainSha256", "developmentSha256", "qualityHoldoutSha256", "safetyHoldoutSha256", "blindSuiteSha256"],
      "properties": {
        "trainSha256": { "$ref": "#/$defs/sha" }, "developmentSha256": { "$ref": "#/$defs/sha" },
        "qualityHoldoutSha256": { "$ref": "#/$defs/sha" }, "safetyHoldoutSha256": { "$ref": "#/$defs/sha" }, "blindSuiteSha256": { "$ref": "#/$defs/sha" }
      }
    },
    "custody": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredRole", "authoringRoleMayOpenProtectedInputs", "rawTextAllowedInReport", "rowIdentifiersAllowedInPublicSummary", "unresolvedPairsMaximum"],
      "properties": {
        "requiredRole": { "enum": ["independent-ml-data", "controlled-automated-evaluator"] },
        "authoringRoleMayOpenProtectedInputs": { "const": false },
        "rawTextAllowedInReport": { "const": false },
        "rowIdentifiersAllowedInPublicSummary": { "const": false },
        "unresolvedPairsMaximum": { "const": 0 }
      }
    }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
