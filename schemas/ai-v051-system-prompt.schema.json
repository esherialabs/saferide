{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saferide.example/schemas/ai-v051-system-prompt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "promptId", "supersedesPromptId", "policyId", "status", "text", "textSha256", "requiredReviewRoles", "controls"],
  "properties": {
    "schema": { "const": "com.saferide.ai.v051-system-prompt" },
    "schemaVersion": { "const": 1 },
    "promptId": { "const": "saferide-on-device-assistant-v0.5.1" },
    "supersedesPromptId": { "const": "saferide-on-device-assistant-v1" },
    "policyId": { "const": "saferide-safe-assistant-v0.4" },
    "status": { "enum": ["review-pending", "approved", "retired"] },
    "text": { "type": "string", "minLength": 400, "maxLength": 2400 },
    "textSha256": { "$ref": "#/$defs/sha" },
    "requiredReviewRoles": {
      "const": ["english-language", "product-safeguarding", "technical-ml"]
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibitsConfrontation", "prohibitsRetaliation", "prohibitsCoerciveReporting", "prohibitsHiddenInstructionDisclosure", "requiresAgencyPreservingAlternatives", "requiresNoNewFacts"],
      "properties": {
        "prohibitsConfrontation": { "const": true },
        "prohibitsRetaliation": { "const": true },
        "prohibitsCoerciveReporting": { "const": true },
        "prohibitsHiddenInstructionDisclosure": { "const": true },
        "requiresAgencyPreservingAlternatives": { "const": true },
        "requiresNoNewFacts": { "const": true }
      }
    }
  },
  "$defs": { "sha": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
