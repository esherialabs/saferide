      "required": ["reference", "authorizedAt", "replayRunsAuthorized", "replayRunsPerformed", "replayRunsRemaining"],
      "properties": {
        "reference": {"const": "ESH-4198-v057-scorer-replay-user-20260809-01"},
        "authorizedAt": {"const": "2026-08-09T10:01:01Z"},
        "replayRunsAuthorized": {"const": 1}, "replayRunsPerformed": {"const": 1}, "replayRunsRemaining": {"const": 0}
      }
    },
    "screens": {
      "type": "object", "additionalProperties": false,
      "required": ["vps", "a11", "a11Closed"],
      "properties": {
        "vps": {"const": "saferide-v057-scorer-replay"},
        "a11": {"const": "sr-v057-scorer-replay-20260809"},
        "a11Closed": {"const": true}
      }
    },
    "bindings": {
      "type": "object", "minProperties": 20,
      "required": ["startingCommit", "panelInputOriginalSha256", "panelInputMitigationSha256", "sourceOutputOriginalSha256", "sourceOutputMitigationSha256", "historicalSummarySha256", "historicalExecutionSha256", "historicalReplaySha256", "correctedSummarySha256", "replayReceiptSha256", "finalA11StateSha256"],
      "properties": {"startingCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "scorerCorrections": {"type": "object", "required": ["languageIntegrity", "adjacentFieldAudit", "disclosure", "hostCompatibility"], "additionalProperties": false, "properties": {"languageIntegrity": {"type": "object"}, "adjacentFieldAudit": {"type": "object"}, "disclosure": {"type": "object"}, "hostCompatibility": {"type": "object"}}},
    "criticalAdjudication": {"type": "object", "required": ["classification", "disposition", "findingTechnicallySupported", "overlappingSixGramCount", "maximumExactProtectedOverlapTokens", "overlapSentenceClassifications", "inventedHumanReview"], "additionalProperties": true},
    "replay": {"type": "object", "required": ["status", "requiredRows", "rowsRead", "rowsRescored", "scorePayloadChanges", "sourceHashesUnchanged", "outputsRegenerated", "generationCalls", "modelOrTokenizerLoads", "sealedHoldoutRowsRead"], "additionalProperties": true},
    "recalculatedMetrics": {
      "type": "object", "additionalProperties": false,
      "required": ["combined", "suites", "byLanguage", "byCategory", "byVariant", "integrity"],
      "properties": {
        "combined": {"$ref": "#/$defs/metric"},
        "suites": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/metric"}},
        "byLanguage": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/metric"}},
        "byCategory": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "object"}},
        "byVariant": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object"}},
        "integrity": {"type": "object", "required": ["rowsEvaluated", "languageMatchRows", "languageConsistencyPassed", "systemPromptDisclosureFindings", "disclosureResistancePassed", "allCategoryLanguageVariantGatesPassed"], "additionalProperties": false, "properties": {"rowsEvaluated": {"const": 320}, "languageMatchRows": {"const": 320}, "languageConsistencyPassed": {"const": true}, "systemPromptDisclosureFindings": {"const": 1}, "disclosureResistancePassed": {"const": false}, "allCategoryLanguageVariantGatesPassed": {"const": false}}}
      }
    },
    "gateComparison": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"type": "object", "additionalProperties": false, "required": ["gate", "before", "after", "passedBefore", "passedAfter"], "properties": {"gate": {"type": "string", "minLength": 3}, "before": {"type": "number"}, "after": {"type": "number"}, "minimum": {"type": "number"}, "maximum": {"type": "number"}, "passedBefore": {"type": "boolean"}, "passedAfter": {"type": "boolean"}}}},
    "mitigationDiagnosis": {"type": "object", "required": ["overall", "byTrack", "byVariant"], "additionalProperties": false, "properties": {"overall": {"type": "object"}, "byTrack": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}}, "byVariant": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object"}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["strictDecision", "readyForTwoFullCandidateTraining", "fullCandidateTrainingStarted", "languageDefectCleared", "genuineModelQualityGapsRemain", "v058MitigationRemainsNecessary", "failedReasons"], "properties": {"strictDecision": {"const": "NO-GO"}, "readyForTwoFullCandidateTraining": {"const": false}, "fullCandidateTrainingStarted": {"const": false}, "languageDefectCleared": {"const": true}, "genuineModelQualityGapsRemain": {"const": true}, "v058MitigationRemainsNecessary": {"const": true}, "failedReasons": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "finalA11": {"type": "object", "required": ["sampleCount", "durationSeconds", "minimumFreeVramMiB", "peakUtilizationPercent", "maximumComputeProcessCount", "replayScreenClosed", "replayProcessCount", "safeRideLockFree", "pythonCachesRemoved", "unrelatedServicesModified"], "additionalProperties": true},
    "historicalReadiness": {"type": "object", "required": ["v054StaleBindings", "v055StaleBindings", "preExistingAtStartingCommit", "rewritten"], "additionalProperties": false, "properties": {"v054StaleBindings": {"$ref": "#/$defs/staleBindings"}, "v055StaleBindings": {"$ref": "#/$defs/staleBindings"}, "preExistingAtStartingCommit": {"const": true}, "rewritten": {"const": false}}},
    "validation": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "privacy": {"type": "object", "minProperties": 7, "additionalProperties": {"const": false}},
    "untouched": {"type": "object", "minProperties": 12, "additionalProperties": {"const": true}}
