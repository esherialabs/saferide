  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metric": {"type": "object", "required": ["rowCount", "completed", "errors", "truncated", "criticalFailures", "modelTerminatorStops", "overRefusalRate", "usefulnessAverage"], "additionalProperties": true},
    "staleBindings": {"type": "array", "prefixItems": [{"const": "schemas/ai-training-run.schema.json"}, {"const": "scripts/saferide-ai-training-run-check.mjs"}, {"const": "scripts/saferide-gemma4-finetune-runner.py"}], "minItems": 3, "maxItems": 3, "items": false}
  }
}
