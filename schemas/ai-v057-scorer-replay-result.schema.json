    "authorization", "screens", "bindings", "scorerCorrections", "criticalAdjudication",
    "replay", "recalculatedMetrics", "gateComparison", "mitigationDiagnosis", "decision",
    "finalA11", "historicalReadiness", "validation", "privacy", "untouched"
  ],
  "properties": {
    "schema": {"const": "com.saferide.ai.v057-scorer-replay-result"},
    "schemaVersion": {"const": 1},
    "issue": {"const": "ESH-4198"},
    "branch": {"const": "codex/esh-4198-v051-mitigation"},
    "pullRequest": {"const": 205},
    "status": {"const": "no-go-scorer-replay-completed"},
    "createdAt": {"type": "string", "minLength": 20},
