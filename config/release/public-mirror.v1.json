    "scripts/__tests__/saferide-evidence-checkout.test.mjs",
    "scripts/__tests__/saferide-gemma4-comparator.test.mjs",
    "scripts/__tests__/saferide-gemma4-development-progression.test.mjs",
    "scripts/__tests__/saferide-gemma4-global-usefulness-v2.test.mjs",
    "scripts/__tests__/saferide-gemma4-v05-controls.test.mjs",
    "scripts/__tests__/saferide-gemma4-v05-production-pipeline.test.mjs",
    "scripts/__tests__/saferide-moderated-cohort.test.mjs",
    "scripts/__tests__/saferide-product-measurement.test.mjs",
    "scripts/__tests__/saferide-review-form.test.mjs",
